{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "group:allNonMajor",
    "security:openssf-scorecard",
    ":disableDependencyDashboard"
  ],
  "pre-commit": { "enabled": true },
  "reviewers": ["ardubev16", "LuigiMiazzo17"],
  "argocd": {
    "managerFilePatterns": [
      "/^appsets/.+\\.yaml$/",
      "/^root-argocd-app\\.yaml$/"
    ]
  },
  "kubernetes": { "managerFilePatterns": ["/^.+\\.yaml$/"] },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^.+/kustomization\\.yaml$/"],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/(?<depName>[^/]+/[^/]+)/(?<currentValue>[^/]+)/.*"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^.+/kustomization\\.yaml$/"],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<currentValue>[^/]+)/.*"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "Traefik plugins",
      "customType": "regex",
      "managerFilePatterns": ["/^.+/values\\.yaml$/"],
      "matchStrings": [
        "moduleName: (?<depName>\\S+)\\s+version: (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "go"
    },
    {
      "description": "Versioned raw GitHub files in the Justfile",
      "customType": "regex",
      "managerFilePatterns": ["/^Justfile$/"],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/(?<depName>[^/]+/[^/]+)/(?<currentValue>v\\d[^/]*)/"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "description": "kro CLI, pinned by commit because cmd/kro has no Go module tags",
      "customType": "regex",
      "managerFilePatterns": ["/^mise\\.toml$/"],
      "matchStrings": [
        "\"go:github\\.com/kubernetes-sigs/kro/cmd/kro\" = \"(?<currentDigest>[a-f0-9]{40})\" # (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "kubernetes-sigs/kro",
      "datasourceTemplate": "github-tags"
    }
  ],
  "packageRules": [
    {
      "description": "Batch all CI and dev tooling updates into one PR, automerged once a week in the Monday 3am window",
      "groupName": "Actions & Checks",
      "matchFileNames": [".github/workflows/**", ".pre-commit-config.yaml", "mise.toml"],
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "automerge": true,
      "automergeSchedule": ["* 0-3 * * 1"],
      "platformAutomerge": false,
      "automergeStrategy": "squash"
    },
    {
      "matchFileNames": ["infrastructure/**"],
      "groupName": "infrastructure non-major",
      "matchUpdateTypes": ["patch", "minor"]
    },
    {
      "matchFileNames": ["platform/**"],
      "groupName": "platform non-major",
      "matchUpdateTypes": ["patch", "minor"]
    },
    {
      "matchFileNames": ["platform/**"],
      "matchPackageNames": ["kube-prometheus-stack"],
      "groupName": "platform non-major",
      "matchUpdateTypes": ["major", "patch", "minor"]
    },
    {
      "matchFileNames": ["applications/icinga/**"],
      "groupName": "icinga2",
      "reviewers": ["LuigiMiazzo17"],
      "separateMajorMinor": false,
      "separateMinorPatch": false
    },
    {
      "matchPackageNames": ["kubernetes-sigs/*"],
      "groupName": "kubernetes-sigs",
      "separateMajorMinor": false,
      "separateMinorPatch": false
    },
    {
      "matchPackageNames": ["ghcr.io/guss-alberto/unitntgbot-*"],
      "groupName": "unitntgbot",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "reviewers": ["ardubev16"],
      "automerge": true
    },
    {
      "matchPackageNames": ["ghcr.io/pelican/*"],
      "versioning": "loose",
      "ignoreUnstable": false
    },
    {
      "description": "Keep the kro CLI used for schema generation in step with the deployed controller",
      "matchPackageNames": [
        "kubernetes-sigs/kro",
        "registry.k8s.io/kro/charts/kro"
      ],
      "groupName": "kro"
    }
  ]
}
